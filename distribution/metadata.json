{
  "schema_version": 1,
  "plugin": {
    "name": "terraphim-skills-intro",
    "display_name": "Terraphim Skills Introduction",
    "version": "0.2.7",
    "description": "Create editor alternatives, search a shared synonym graph, capture learning, and retrieve memory with Terraphim.",
    "description_zh_cn": "在编辑器中创建备选措辞、搜索共享同义词图、记录经验并检索记忆。",
    "author_name": "Terraphim AI",
    "author_email": "engineering@terraphim.ai",
    "homepage": "https://terraphim-skills.md/",
    "catalogue": "https://terraphim-skills.md/skills/",
    "repository": "https://github.com/terraphim/terraphim-cursor-plugin",
    "license": "Apache-2.0",
    "category": "developer-tools",
    "keywords": [
      "terraphim",
      "code-search",
      "learning",
      "memory",
      "knowledge-graph",
      "developer-tools"
    ]
  },
  "runtime": {
    "tap": "terraphim/terraphim",
    "release": "https://terraphim-skills.md/docs/non-technical/",
    "formulae": [
      "terraphim-grep",
      "terraphim-agent"
    ],
    "verify": [
      "terraphim-grep --version",
      "terraphim-agent --version",
      "terraphim-agent learn --help",
      "terraphim-agent memory --help"
    ]
  },
  "skills": [
    {
      "name": "terraphim-grep",
      "path": "skills/terraphim-grep",
      "command": "terraphim-grep",
      "mode": "read-only-by-default"
    },
    {
      "name": "terraphim-agent-learn",
      "path": "skills/terraphim-agent-learn",
      "command": "terraphim-agent learn",
      "mode": "explicit-writes"
    },
    {
      "name": "terraphim-agent-memory",
      "path": "skills/terraphim-agent-memory",
      "command": "terraphim-agent memory",
      "mode": "explicit-writes"
    },
    {
      "name": "terraphim-editor",
      "path": "skills/terraphim-editor",
      "command": "terraphim-grep",
      "mode": "explicit-writes"
    }
  ],
  "cursor_integration": {
    "schema_version": 1,
    "files": [
      "docs/cli-workflows.md",
      "docs/examples/risk-concern.knowledge-graph.json",
      "integrations/cursor/README.md",
      "integrations/cursor/commands/terraphim-setup.md",
      "integrations/cursor/examples/README.md",
      "integrations/cursor/examples/compiled-corrections.json",
      "integrations/cursor/examples/concepts/Risk.md",
      "integrations/cursor/examples/corpus/brief.md",
      "integrations/cursor/examples/corpus/decision.md",
      "integrations/cursor/examples/corpus/review.md",
      "integrations/cursor/examples/guard-rules.json",
      "integrations/cursor/examples/role-config.json.example",
      "integrations/cursor/examples/settings.toml.example",
      "integrations/cursor/hook_adapter.py",
      "integrations/cursor/hooks.json.example",
      "integrations/cursor/mcp.json.example",
      "integrations/cursor/policy.json.example",
      "integrations/cursor/release-inputs.json",
      "schemas/cursor-hook-policy.schema.json",
      "schemas/cursor-hook-receipt.schema.json"
    ]
  }
}
